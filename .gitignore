# Source-only repository: opt in to product source and reproducible tooling.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/src/
!/desktop/
!/public/
!/tests/
!/skills/
!/scripts/
/desktop/icon.ico
/skills/director-desk/scripts/project-tool.mjs
/scripts/*
!/scripts/build-offline-skill.mjs
!/scripts/offline-project-entry.ts
!/scripts/prepare-desktop.mjs
!/scripts/check-release-privacy.mjs
!/scripts/package-portable.ps1
!/scripts/smoke.mjs
!/scripts/verify-interactions.mjs
!/scripts/verify-workspace.mjs
!/scripts/verify-editing.mjs
!/scripts/verify-timeline.mjs
!/scripts/verify-building.mjs
!/scripts/test-ai-desktop.mjs
!/scripts/test-ai-conversation-restart.mjs
!/scripts/test-release-privacy.mjs
!/scripts/download-test-models.mjs
!/scripts/download-fbx-fixtures.mjs

# Credentials and local artifacts remain excluded inside source directories too.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
ai-channels.json
ai-conversation.json
*.log
*.zip
*.exe
